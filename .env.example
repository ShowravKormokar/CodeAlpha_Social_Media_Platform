# =========================================================
# Docker Compose environment
# =========================================================
# Copy this file to `.env` before running `docker compose up -d`:
#
#   cp .env.example .env
#   docker compose up -d
#
# Every value below is a DEVELOPMENT DEFAULT. They are safe for
# local use only. Never reuse these values in production.
# =========================================================


# ---------------------------------------------------------
# Published host ports
# ---------------------------------------------------------
# Frontend (nginx static server)
FRONTEND_PORT=5500

# Backend (Express API)
API_PORT=5000


# ---------------------------------------------------------
# Backend application
# ---------------------------------------------------------
NODE_ENV=production
PORT=5000

# Development only - replace with long random values in production.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Must match the URL the frontend is opened from.
CORS_ORIGIN=http://localhost:5500


# ---------------------------------------------------------
# Cookies
# ---------------------------------------------------------
COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token


# ---------------------------------------------------------
# Database (PostgreSQL container)
# ---------------------------------------------------------
POSTGRES_DB=social_media
POSTGRES_USER=postgres
# Development only. Do not reuse this password in production.
POSTGRES_PASSWORD=postgres

# DATABASE_URL is assembled automatically by docker-compose.yml
# from the values above, pointing at the `db` service on the
# internal Docker network. Uncomment and edit only if you need a
# custom connection string.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/social_media


# ---------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


# ---------------------------------------------------------
# Media / image uploads
# ---------------------------------------------------------
# Only `local` exists in Phase 01; S3/R2 later. Images are stored
# in the `media_data` volume mounted at /app/storage, outside src/,
# so they can never be served as executable application content.
MEDIA_STORAGE_PROVIDER=local
MEDIA_UPLOAD_DIR=/app/storage/uploads
MEDIA_PUBLIC_PATH=/uploads
# Hard ceiling applied before decoding (bytes). Per-purpose limits
# live in backend/src/modules/media/media.constants.js.
MEDIA_MAX_FILE_SIZE=8388608


# ---------------------------------------------------------
# Optional: seed demo data
# ---------------------------------------------------------
# Seeding is NEVER automatic. Run it explicitly when needed:
#
#   docker compose run --rm migrate npm run db:seed
#
# The seed script is only partially idempotent (users and profiles
# are upserted, posts and comments are appended), so running it
# repeatedly will add duplicate posts and comments.
