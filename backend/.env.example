# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_media

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# CORS
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Media / image uploads (Phase 01)
# Storage provider. Only `local` exists in Phase 01; S3/R2 later.
MEDIA_STORAGE_PROVIDER=local
# Absolute or relative directory for stored images. Defaults to
# backend/storage/uploads, which sits outside src/ so uploaded files
# can never be executed as application resources.
MEDIA_UPLOAD_DIR=
# Public URL prefix that maps onto the upload directory.
MEDIA_PUBLIC_PATH=/uploads
# Hard ceiling applied before any decoding happens (bytes). Per-purpose
# limits are defined in src/modules/media/media.constants.js.
MEDIA_MAX_FILE_SIZE=8388608
MEDIA_MAX_FILES=1
MEDIA_WEBP_QUALITY=82
MEDIA_JPEG_QUALITY=85